map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

map $http_x_forwarded_proto $forwarded_proto {
  default $scheme;
  https https;
}

server {
  listen 80 default_server;
  server_name ${GATEWAY_SERVER_NAME};

  resolver 127.0.0.11 valid=30s ipv6=off;

  set $api_upstream http://api:3000;
  set $minio_upstream http://minio:9000;
  set $web_upstream http://web:5173;

  location = /healthz {
    access_log off;
    add_header Content-Type text/plain;
    return 200 'ok';
  }

  # Same-origin S3 path-style signed URLs. The original Host and URI are part
  # of the SigV4 signature and must reach MinIO unchanged.
  location ^~ /${MINIO_BUCKET}/ {
    access_log off;
    client_max_body_size 51m;
    limit_except GET HEAD {
      deny all;
    }
    proxy_http_version 1.1;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
    proxy_pass $minio_upstream;
    proxy_set_header Host $http_host;
    proxy_set_header Authorization '';
    proxy_set_header Cookie '';
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_hide_header Set-Cookie;
  }

  # Restore carries an entire archive in one request, so it needs a far larger
  # ceiling than an attachment upload. Scoped to the backup routes only, and
  # still bounded: the API applies the authoritative limit behind this.
  location ^~ /api/backup/ {
    client_max_body_size ${BACKUP_MAX_UPLOAD_MB}m;
    proxy_http_version 1.1;
    proxy_request_buffering off;
    # A restore rewrites every table and re-uploads every object.
    proxy_read_timeout 900s;
    proxy_send_timeout 900s;
    proxy_pass $api_upstream;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
  }

  location ^~ /api/ {
    # The API performs the authoritative upload limits and MIME validation.
    client_max_body_size 51m;
    proxy_http_version 1.1;
    proxy_request_buffering off;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
    proxy_pass $api_upstream;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
  }

  location / {
    # Vite is kept behind the gateway for the Compose development workflow.
    proxy_http_version 1.1;
    proxy_buffering off;
    proxy_pass $web_upstream;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_cache_bypass $http_upgrade;
  }
}
