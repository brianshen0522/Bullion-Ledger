# Bullion Ledger — local development environment.
# All secrets shown are EXAMPLE ONLY. Copy to .env and regenerate.
# Never commit a real .env.

# --- Node / app ---
NODE_ENV=development
PORT=3000
API_PREFIX=api

# --- Single public gateway ---
# Default binds only to this computer. Use 0.0.0.0 only on a trusted network
# or behind an HTTPS edge that you control.
GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_PORT=5173
GATEWAY_SERVER_NAME=_
# One gateway hop by default. Use 2 only when direct gateway access is blocked
# and one controlled TLS proxy sits in front of it.
GATEWAY_TRUST_PROXY_HOPS=1
# Exact origin visible to browsers. This is the canonical origin for CORS/CSRF,
# WebAuthn, and same-origin signed object URLs.
PUBLIC_ORIGIN=http://localhost:5173
NGINX_IMAGE=nginx:1.27-alpine

# --- CORS / CSRF ---
# Add only legitimate secondary browser origins here.
CSRF_ALLOWED_ORIGINS=
# Standalone API trusts no proxy. Compose sets one controlled gateway hop.
TRUST_PROXY_HOPS=0

# --- Database (PostgreSQL) ---
# Matches docker-compose `postgres` service.
POSTGRES_USER=bullion
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=bullion_ledger
DATABASE_URL=postgresql://bullion:change_me_in_production@localhost:5432/bullion_ledger?schema=public

# --- Redis (BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- Session security ---
# IMPORTANT: generate a strong value, e.g. `openssl rand -hex 48`.
SESSION_SECRET=replace_with_long_random_value_at_least_32_chars_long_xxxxxx
SESSION_COOKIE_NAME=bl_session
SESSION_ABSOLUTE_TTL_SEC=604800
SESSION_IDLE_TTL_SEC=1800
COOKIE_SECURE=
# Development only. Production defaults to false and refuses HTTP initialization
# unless this switch is explicitly enabled for a short bootstrap window.
ALLOW_HTTP_INIT=true

# --- Login throttling ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_WINDOW_SEC=900

# --- Argon2id parameters ---
ARGON_TIME_COST=3
ARGON_MEMORY_COST=19456
ARGON_PARALLELISM=1

# --- Object storage (MinIO, private bucket) ---
# API-to-MinIO endpoint. In Docker this is normally http://minio:9000.
MINIO_INTERNAL_ENDPOINT=http://localhost:9000
# Standalone MinIO endpoint embedded in signed browser URLs. Compose overrides
# this with PUBLIC_ORIGIN and routes the bucket through its gateway.
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
# Backward-compatible fallback; prefer the two explicit endpoints above.
MINIO_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=bullion_minio
MINIO_SECRET_KEY=change_me_minio_secret
# Must not be named "api", which is reserved by the gateway route.
MINIO_BUCKET=bullion-ledger
MINIO_SIGNED_URL_TTL_SEC=300
# Same-origin raw attachment safeguards. Values are bytes except pixels.
ATTACHMENT_IMAGE_MAX_BYTES=26214400
ATTACHMENT_PDF_MAX_BYTES=52428800
ATTACHMENT_INTAKE_MAX_BYTES=262144000
ATTACHMENT_MAX_PIXELS=60000000
# Per-attachment quota across all non-ORIGINAL crop/scan/PDF revisions.
ATTACHMENT_DERIVATIVE_MAX_REVISIONS=20
ATTACHMENT_DERIVATIVE_MAX_BYTES=104857600
# Pinned development images; override only with a reviewed release.
MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-09-07T16-13-09Z
MINIO_MC_IMAGE=quay.io/minio/mc:RELEASE.2025-08-13T08-35-41Z

# --- WebAuthn (RP identity). Must match the public origin exactly. ---
# WEBAUTHN_RP_ID is the hostname only, no scheme or port. It must be a
# registrable domain: "localhost" works, a bare IP address such as 127.0.0.1
# can never host passkeys, so browse to http://localhost:5173 (not 127.0.0.1)
# when testing Touch ID locally.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME="Bullion Ledger"
# Optional override: comma-separated origins when one deployment is
# legitimately reachable at more than PUBLIC_ORIGIN.
# WEBAUTHN_ORIGIN=https://ledger.example.com,https://ledger.internal.example

# Keep production source maps private unless explicitly required.
GENERATE_SOURCEMAP=false

# --- Market data (PRD §12) ---
# Preferred provider id; the rest act as fallbacks in registration order.
# Known ids: gold-api (spot), exchangerate-api (fx), currency-api (spot+fx+history).
# Leave empty to use the default ordering. None of the bundled providers
# require an API key.
PRICE_PROVIDER=
PRICE_PROVIDER_API_KEY=
# Currency the upstream quotes metals in, before conversion for display.
PRICE_BASE_CURRENCY=USD
# Scheduling (PRD §12.3). Interval is milliseconds, clamped to 1 min - 24 h.
PRICE_SYNC_INTERVAL_MS=300000
PRICE_FX_CRON=
PRICE_HOURLY_CRON=
PRICE_DAILY_CRON=
# Days of history seeded on scheduler startup (0 disables, max 400). Only days
# not already stored are fetched, so restarting does not re-download anything.
PRICE_BACKFILL_DAYS=365

# --- Backup / restore (PRD §24) ---
# Largest archive accepted by the restore endpoint, in MB. Applied only to the
# backup routes; every other endpoint keeps the small default body limit.
BACKUP_MAX_UPLOAD_MB=256

# --- Display defaults (PRD §31 leaves base currency / branding open) ---
# Valuation currency. Spot is fetched in PRICE_BASE_CURRENCY and converted here.
DEFAULT_CURRENCY=TWD
DEFAULT_TIMEZONE=Asia/Taipei
DEFAULT_WEIGHT_UNIT=g
